{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "address": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地点"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place"
          }
        }
      }
    },
    "api_token_help": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取车辆、状态、行程和充电时，TeslaMateApi 默认不校验令牌。如果填写了，每次请求都会带上 Authorization: Bearer。命令类接口和部分反向代理会用到它。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TeslaMateApi does not check the token for cars, status, drives, or charges. When set, every request sends Authorization: Bearer. Command endpoints and some reverse proxies do require it."
          }
        }
      }
    },
    "api_token_label": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 令牌（可选）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API token (optional)"
          }
        }
      }
    },
    "api_token_placeholder": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少 32 位，留空则不发送"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least 32 characters, or leave empty"
          }
        }
      }
    },
    "asleep_hint": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "车辆正在休眠。下面是 MQTT 上一次上报的数据，不会为了刷新而唤醒车辆。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The car is asleep. These are the last values published on MQTT. Refresh does not wake the car."
          }
        }
      }
    },
    "base_url_help": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写根地址即可，不要带 /api/v1。局域网可以使用 http。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the origin only, without /api/v1. Plain http is allowed for a LAN server."
          }
        }
      }
    },
    "base_url_label": {
      "extractionState": "manual",
